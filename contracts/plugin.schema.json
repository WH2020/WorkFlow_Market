{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-market.local/contracts/plugin.schema.json",
  "title": "Vertical Agent Plugin Manifest",
  "type": "object",
  "required": ["api_version", "id", "version", "display_name", "description", "category", "permissions", "dependencies", "skills", "workflows"],
  "properties": {
    "api_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "category": {"type": "string", "enum": ["shared", "market", "product"]},
    "permissions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {"id": {"type": "string"}, "version": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "skills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "workflows": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": true
}
