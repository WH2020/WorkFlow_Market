{
  "name": "workflow-director-agent",
  "version": "0.20.4",
  "type": "module",
  "description": "A single-role Sales Director AI Assistant with customer, government, presentation, and governed bidding workflows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WH2020/WorkFlow_Market.git"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "keywords": [
    "pi-package",
    "vertical-agent",
    "workflow",
    "sales-director",
    "government-cooperation"
  ],
  "scripts": {
    "check:types": "tsc --noEmit",
    "test:ui-models": "node --test tests/ui-model-settings.test.mjs",
    "test:ui-wxdecipher": "node --test tests/ui-wxdecipher.test.mjs",
    "test:ui-wxdecipher-browser": "node tests/ui-wxdecipher-browser.mjs",
    "test:provider-e2e": "node --test pi/tests/provider-transport-e2e.test.mjs",
    "test:cli-providers": "node --test pi/tests/cli-model-provider.test.ts pi/tests/cli-provider-e2e.test.mjs",
    "test:cli-native-offline": "node --test pi/tests/cli-native-offline.test.mjs",
    "test:runtime": "node --test tests/task-runtime.test.ts tests/vertical-workflow-selection.test.ts pi/tests/model-boundaries.test.ts pi/tests/provider-transport-e2e.test.mjs pi/tests/data-adapters.test.ts pi/tests/weekly-briefing.test.ts pi/tests/source-readers.test.ts pi/tests/subagent-contracts.test.ts pi/tests/web-search.test.ts pi/tests/deck-builder.test.mjs pi/tests/bid-store.test.ts pi/tests/bid-document-builder.test.mjs",
    "test:sqlite-gate": "node pi/tests/sqlite-driver-gate.mjs",
    "test:ppt-e2e": "node pi/tests/standalone-deck-e2e.mjs",
    "build:macos": "bash scripts/build-macos-desktop.sh"
  },
  "pi": {
    "extensions": [
      "./pi/extensions/cli-model-provider.ts",
      "./pi/extensions/vertical-workflow.ts",
      "./node_modules/pi-subagents/index.ts"
    ],
    "subagents": {
      "agents": [
        "./pi/subagents/agents"
      ]
    }
  },
  "bundledDependencies": [
    "pi-subagents"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2",
    "typebox": ">=1.3.15 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@napi-rs/canvas": "1.0.7",
    "jszip": "3.10.1",
    "pdfjs-dist": "6.2.108",
    "pi-subagents": "0.51.0",
    "pptxgenjs": "4.0.1"
  }
}
