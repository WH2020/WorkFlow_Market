{
  "id": "shared.presentation.studio-quick-v2",
  "plugin": "shared.presentation-studio",
  "display_name": "内部快速演示文稿（仅已有资料）",
  "entry_nodes": [
    "create_brief"
  ],
  "output_nodes": [
    "render_deck"
  ],
  "nodes": [
    {
      "id": "create_brief",
      "type": "agent",
      "skill": "plan-director-presentations",
      "depends_on": [],
      "permissions": []
    },
    {
      "id": "search_knowledge",
      "type": "tool",
      "tool": "knowledge.search",
      "depends_on": [
        "create_brief"
      ],
      "permissions": [
        "knowledge.read"
      ]
    },
    {
      "id": "propose_outline",
      "type": "agent",
      "skill": "plan-director-presentations",
      "depends_on": [
        "search_knowledge"
      ],
      "permissions": []
    },
    {
      "id": "save_outline",
      "type": "tool",
      "tool": "presentation.plan.write",
      "depends_on": [
        "propose_outline"
      ],
      "permissions": [
        "presentation.plan.write"
      ]
    },
    {
      "id": "build_storyboard_and_design",
      "type": "agent",
      "skill": "plan-director-presentations",
      "depends_on": [
        "save_outline"
      ],
      "permissions": []
    },
    {
      "id": "save_final_plan",
      "type": "tool",
      "tool": "presentation.plan.write",
      "depends_on": [
        "build_storyboard_and_design"
      ],
      "permissions": [
        "presentation.plan.write"
      ]
    },
    {
      "id": "validate_and_freeze",
      "type": "validator",
      "check": "presentation_plan_matches_evidence_and_frozen_deck_payload",
      "depends_on": [
        "save_final_plan"
      ],
      "permissions": []
    },
    {
      "id": "approve_render",
      "type": "approval",
      "policy": "user_confirms_exact_payload_sha256_before_artifact_commit",
      "depends_on": [
        "validate_and_freeze"
      ],
      "permissions": []
    },
    {
      "id": "render_deck",
      "type": "tool",
      "tool": "artifact.deck.write",
      "depends_on": [
        "approve_render"
      ],
      "permissions": [
        "artifact.write"
      ]
    }
  ]
}
