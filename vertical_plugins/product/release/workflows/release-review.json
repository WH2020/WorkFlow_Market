    {"id": "gate", "type": "validator", "check": "acceptance_risks_observability_and_rollback", "depends_on": ["review"], "permissions": []},
    {"id": "decision", "type": "approval", "policy": "release_owner_decides_go_no_go", "depends_on": ["gate"], "permissions": []},
    {"id": "record_decision", "type": "tool", "tool": "knowledge.write", "depends_on": ["decision"], "permissions": ["knowledge.write"]}
  ]
