{
  "id": "product-director",
  "display_name": "产品总监 AI 助手",
  "description": "复用轻本体与共享能力，覆盖产品发现、需求、路线图、发布和周报。",
  "plugins": [
    "shared.research",
    "shared.documents",
    "shared.weekly-report",
    "product.discovery",
    "product.requirements",
    "product.metrics",
    "product.roadmap",
    "product.release"
  ],
  "default_service": "product-discovery",
  "services": [
    {"id": "product-discovery", "display_name": "产品机会调研", "description": "从用户问题和证据形成可验证的产品机会。", "workflow": "product.discovery.opportunity", "skill": "product-discovery"},
    {"id": "product-prd", "display_name": "需求澄清与 PRD", "description": "逐项核对范围、状态、约束和验收标准。", "workflow": "product.requirements.prd", "skill": "manage-product-requirements"},
    {"id": "product-metrics", "display_name": "产品指标与实验", "description": "定义指标口径、目标、护栏与验证实验。", "workflow": "product.metrics.experiment", "skill": "design-product-metrics"},
    {"id": "product-roadmap", "display_name": "产品路线图", "description": "按目标、证据、依赖和资源约束规划优先级。", "workflow": "product.roadmap.plan", "skill": "plan-product-roadmap"},
    {"id": "release-review", "display_name": "发布检查与复盘", "description": "确认发布条件、风险、回滚和指标闭环。", "workflow": "product.release.review", "skill": "review-product-release"},
    {"id": "weekly-deck", "display_name": "周五工作汇报", "description": "汇总本周事实并生成经确认的 PPT。", "workflow": "shared.reporting.weekly-deck", "skill": "build-director-decks"}
  ]
}
